# Derleme ciktilari -------------------------------------------------------
# bin/ tamamen uretilen bir klasordur: build.cmd her seyi yeniden olusturur.
bin/
*.exe
*.pdb
*.old.exe

# WinDivert surucusu ------------------------------------------------------
# Ayri bir projedir (LGPLv3 / GPLv2) ve depoya konmaz.
# tools/setup-windivert.cmd resmi surum sayfasindan indirir.
WinDivert.dll
WinDivert*.sys
WinDivert.lib

# Gunlukler ---------------------------------------------------------------
# DIKKAT: bu dosyalar hangi siteleri test ettigini icerir. Depoya konmamali.
*.log
etodpx-tune.log
etodpx-test.log

# Kullaniciya ozel ayar ---------------------------------------------------
# Depodaki sablon kok dizindeki etodpx.conf; bin/etodpx.conf kisiye ozeldir
# (etodpx-tune.exe hatta gore yazar).
bin/etodpx.conf

# Uretilen simge onizlemeleri (assets/etodpx.ico DEPOYA GIRER) --------------
assets/preview-*.png
assets/etodpx-?.ico

# Uretilen paylasim paketi ------------------------------------------------
release/

